{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example/standards/ess/info.schema.json",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/header"
    }
  ],
  "properties": {
    "type": {
      "const": "info"
    },
    "payload": {
      "type": "object",
      "required": [
        "ems_model",
        "firmware",
        "control_modes",
        "interval_sec",
        "battery",
        "pcs",
        "bms_capabilities",
        "soc_limit_min_pct",
        "soc_limit_max_pct"
      ],
      "properties": {
        "ems_model": {
          "type": "string",
          "maxLength": 128
        },
        "firmware": {
          "type": "string",
          "maxLength": 64
        },
        "control_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "IMMEDIATE",
              "SCHEDULE"
            ]
          }
        },
        "schedule_resolution_min": {
          "type": "integer",
          "enum": [
            5,
            15,
            30,
            60
          ],
          "description": "스케줄 최소 슬롯 단위(분). SCHEDULE 지원 시 필수. 허용값은 5·15·30·60이며 하한은 5분입니다(1분 슬롯 미지원)"
        },
        "interval_sec": {
          "type": "integer",
          "minimum": 1,
          "description": "telemetry 발행 주기(초)"
        },
        "bms_capabilities": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/bmsCapability"
          },
          "description": "BMS가 제공 가능한 telemetry battery 항목의 자기신고 목록. 여기에 신고한 항목은 telemetry에 필수, 신고하지 않은 항목은 생략 가능합니다. 제공 항목이 없으면 빈 배열([])을 명시합니다(키 생략 불가). avail_charge_w↔avail_discharge_w 와 rack_total↔rack_online 은 각각 쌍이므로 한쪽만 신고할 수 없습니다(아래 allOf가 강제) — telemetry battery 의 쌍 if/then 과 정합시키기 위한 제약입니다"
        },
        "soc_limit_min_pct": {
          "$ref": "common.schema.json#/$defs/pct",
          "description": "이 자원에 등록된 SoC 하한(정수 %). 명령의 soc_min_pct는 이 값 이상이어야 하며, 벗어나면 EMS가 BAD_REQUEST로 거부합니다"
        },
        "soc_limit_max_pct": {
          "$ref": "common.schema.json#/$defs/pct",
          "description": "이 자원에 등록된 SoC 상한(정수 %). 명령의 soc_max_pct는 이 값 이하여야 하며, 벗어나면 EMS가 BAD_REQUEST로 거부합니다"
        },
        "failsafe_mode": {
          "$ref": "common.schema.json#/$defs/failsafeMode",
          "description": "해줌↔EMS 두절 시 기본 거동 자기신고. 생략 시 SCHEDULE_HOLD(등록 스케줄 지속 + SoC 한계 준수)로 간주합니다"
        },
        "min_polarity_gap_sec": {
          "type": "integer",
          "minimum": 0,
          "description": "충↔방전 극성 전환 최소 휴지 시간(초) 자기신고. 생략 시 제약 없음으로 간주합니다. 위반 명령은 EMS가 BAD_REQUEST로 거부하며, 명령에 override_polarity_gap=true가 실린 경우에만 무시합니다(01 §5.1)"
        },
        "ems": {
          "type": "object",
          "required": [
            "operation_modes"
          ],
          "description": "EMS 운전상태 readback의 자기기술. 제공 가능 여부는 [권장안 · 협의 필요 — 협력사 확인]이며 블록 자체는 선택입니다",
          "properties": {
            "operation_modes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "common.schema.json#/$defs/operationMode"
              },
              "description": "이 EMS가 가질 수 있는 운전모드 목록. telemetry ems.operation_mode는 이 목록 안의 값이어야 합니다(§7)"
            }
          }
        },
        "battery": {
          "type": "object",
          "required": [
            "rated_energy_wh"
          ],
          "properties": {
            "rated_energy_wh": {
              "type": "integer",
              "minimum": 0,
              "description": "배터리 정격 에너지(Wh, 정수)"
            },
            "rated_power_w": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "pcs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "id",
              "rated_power_w"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/idString"
              },
              "rated_power_w": {
                "type": "integer",
                "minimum": 0
              },
              "model": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        },
        "pv": {
          "type": "object",
          "properties": {
            "capacity_w": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "control_modes": {
                "contains": {
                  "const": "SCHEDULE"
                }
              }
            }
          },
          "then": {
            "required": [
              "schedule_resolution_min"
            ]
          }
        },
        {
          "if": {
            "required": [
              "bms_capabilities"
            ],
            "properties": {
              "bms_capabilities": {
                "contains": {
                  "const": "avail_charge_w"
                }
              }
            }
          },
          "then": {
            "properties": {
              "bms_capabilities": {
                "contains": {
                  "const": "avail_discharge_w"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "bms_capabilities"
            ],
            "properties": {
              "bms_capabilities": {
                "contains": {
                  "const": "avail_discharge_w"
                }
              }
            }
          },
          "then": {
            "properties": {
              "bms_capabilities": {
                "contains": {
                  "const": "avail_charge_w"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "bms_capabilities"
            ],
            "properties": {
              "bms_capabilities": {
                "contains": {
                  "const": "rack_total"
                }
              }
            }
          },
          "then": {
            "properties": {
              "bms_capabilities": {
                "contains": {
                  "const": "rack_online"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "bms_capabilities"
            ],
            "properties": {
              "bms_capabilities": {
                "contains": {
                  "const": "rack_online"
                }
              }
            }
          },
          "then": {
            "properties": {
              "bms_capabilities": {
                "contains": {
                  "const": "rack_total"
                }
              }
            }
          }
        }
      ]
    }
  }
}
