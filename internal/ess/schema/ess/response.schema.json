{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example/standards/ess/response.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "rtu_id",
    "req_id",
    "accepted",
    "result"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "type": {
      "type": "string",
      "const": "response"
    },
    "rtu_id": {
      "$ref": "common.schema.json#/$defs/idString"
    },
    "req_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "accepted": {
      "type": "boolean"
    },
    "result": {
      "$ref": "common.schema.json#/$defs/ackState"
    },
    "mode": {
      "type": "string",
      "enum": [
        "IMMEDIATE",
        "SCHEDULE"
      ]
    },
    "direction": {
      "$ref": "common.schema.json#/$defs/direction"
    },
    "power_w": {
      "type": "integer",
      "minimum": 0,
      "description": "IMMEDIATE 수신 전력 readback(W, 정수)"
    },
    "slots_count": {
      "type": "integer",
      "minimum": 0,
      "description": "SCHEDULE 수신 슬롯 수 readback"
    },
    "received_at": {
      "$ref": "common.schema.json#/$defs/epochMillis"
    },
    "failure_reason": {
      "$ref": "common.schema.json#/$defs/failureReason"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "accepted": {
            "const": false
          }
        },
        "required": [
          "accepted"
        ]
      },
      "then": {
        "required": [
          "failure_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "accepted": {
            "const": true
          }
        },
        "required": [
          "accepted"
        ]
      },
      "then": {
        "required": [
          "mode"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "accepted": {
            "const": true
          },
          "mode": {
            "const": "IMMEDIATE"
          }
        },
        "required": [
          "accepted",
          "mode"
        ]
      },
      "then": {
        "required": [
          "direction",
          "power_w"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "accepted": {
            "const": true
          },
          "mode": {
            "const": "SCHEDULE"
          }
        },
        "required": [
          "accepted",
          "mode"
        ]
      },
      "then": {
        "required": [
          "slots_count"
        ]
      }
    }
  ]
}
