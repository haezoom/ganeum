{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example/standards/pv/result.schema.json",
  "allOf": [{ "$ref": "common.schema.json#/$defs/header" }],
  "properties": {
    "type": { "const": "result" },
    "payload": {
      "type": "object",
      "required": ["req_id", "result", "reached_power_w", "max_power_w"],
      "properties": {
        "req_id": { "$ref": "common.schema.json#/$defs/uuidLower" },
        "result": { "$ref": "common.schema.json#/$defs/resultState" },
        "effective_at": { "$ref": "common.schema.json#/$defs/epochMillis" },
        "reached_power_w": { "type": "integer" },
        "max_power_w": { "type": "integer", "minimum": 0 },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "inverters": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["id", "result"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/idString" },
              "result": { "$ref": "common.schema.json#/$defs/inverterResultState" },
              "max_power_w": { "type": "integer", "minimum": 0 },
              "reached_power_w": { "type": "integer" }
            }
          }
        },
        "failure_reason": { "$ref": "common.schema.json#/$defs/failureReason" }
      },
      "allOf": [
        {
          "if": { "properties": { "result": { "enum": ["PARTIAL", "FAILURE"] } }, "required": ["result"] },
          "then": { "required": ["failure_reason"] }
        },
        {
          "if": { "properties": { "result": { "enum": ["SUCCESS", "PARTIAL"] } }, "required": ["result"] },
          "then": { "required": ["effective_at"] }
        }
      ]
    }
  }
}
