{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example/standards/pv/info.schema.json",
  "allOf": [{ "$ref": "common.schema.json#/$defs/header" }],
  "properties": {
    "type": { "const": "info" },
    "payload": {
      "type": "object",
      "required": ["model", "firmware", "control_type", "interval_sec", "inverters"],
      "properties": {
        "model": { "type": "string", "maxLength": 128 },
        "firmware": { "type": "string", "maxLength": 64 },
        "control_type": { "type": "string", "enum": ["CONTINUOUS", "ON_OFF"] },
        "interval_sec": { "type": "integer", "minimum": 1 },
        "inverters": {
          "type": "array", "minItems": 1, "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["id", "capacity_w"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/idString" },
              "model": { "type": "string", "maxLength": 128 },
              "capacity_w": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
