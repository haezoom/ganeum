{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example/standards/pv/common.schema.json",
  "$defs": {
    "epochMillis": { "type": "integer", "minimum": 0 },
    "idString": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
    "uuidLower": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "description": "가늠 강화: 소문자 UUID만 허용(온보딩 §3.3)" },
    "header": {
      "type": "object",
      "required": ["schema_version", "id", "type", "rtu_id", "event_time", "ingest_time", "payload"],
      "properties": {
        "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "id": { "$ref": "#/$defs/uuidLower" },
        "type": { "type": "string", "enum": ["telemetry", "info"] },
        "rtu_id": { "$ref": "#/$defs/idString" },
        "event_time": { "$ref": "#/$defs/epochMillis" },
        "ingest_time": { "$ref": "#/$defs/epochMillis" },
        "seq": { "type": "integer", "minimum": 0 }
      }
    },
    "inverterStatus": { "type": "string", "enum": ["RUN", "IDLE", "STOP", "FAULT", "UNKNOWN"] },
    "reason": { "type": "string", "enum": ["PROTECTION_TRIP", "GRID_ABNORMAL", "COMM_LOST", "CURTAILMENT", "MAINTENANCE", "DEVICE_FAULT", "OTHER"] }
  }
}
